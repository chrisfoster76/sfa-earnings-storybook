{
  "name": "Progression - Adjusted Completion Date on Original Episode",
  "subGroup": "Progression",
  "description": "ZSC00001 posted with 30% milestone and completion date, then approved. A PUT adds ZSC00002 alongside ZSC00001 (progression). A second PUT adjusts the completion date on ZSC00001 while keeping ZSC00002 in the payload — exercising that updates to the original episode still flow through to Earnings correctly when a progression episode also exists.",
  "wipeOnRun": true,
  "tags": ["FLP-1894"],
  "steps": [
    {
      "name": "SLD Creates Short Course 1 (ZSC00001, 30% + completion)",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-course1.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Short Course 1",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-approve-course1.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD PUTs ZSC00001 (30% + completion 2026-01-15) + ZSC00002 (new) — Progression",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "04-put-both-courses.json",
      "extract": {}
    },
    {
      "name": "Verify 2 Learnings created, ZSC00002 unapproved earnings profile, then press Enter to adjust ZSC00001 completion date",
      "type": "Wait"
    },
    {
      "name": "SLD PUTs ZSC00001 (30% + adjusted completion 2026-01-20) + ZSC00002 — date correction on original episode",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "06-put-adjusted-completion.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "2 ShortCourseEpisode rows in Learning DB",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "assert-learning-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 ShortCourseEpisode rows in Earnings DB",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-earnings-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 ThirtyPercent instalments (1 per course)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-thirty-percent-instalments.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 LearningComplete instalments (1 per course)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-learning-complete-instalments.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "1 payable ThirtyPercent instalment (ZSC00001 only — ZSC00002 unapproved)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-payable-thirty-percent.sql",
      "expected": [
        { "field": "Count", "value": "1" }
      ]
    },
    {
      "name": "1 payable LearningComplete instalment (ZSC00001 only — ZSC00002 unapproved)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-payable-learning-complete.sql",
      "expected": [
        { "field": "Count", "value": "1" }
      ]
    },
    {
      "name": "ZSC00001 LearningComplete instalment in delivery period 6 (adjusted completion date 2026-01-20 still in January)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-learning-complete-delivery-period.sql",
      "expected": [
        { "field": "DeliveryPeriod", "value": "6" }
      ]
    }
  ]
}
