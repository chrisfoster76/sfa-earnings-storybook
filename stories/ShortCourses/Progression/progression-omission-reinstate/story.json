{
  "name": "Progression - Remove by Omission then Reinstate",
  "group": "Short Course",
  "subGroup": "Progression",
  "description": "ZSC00001 completed and approved. A single PUT adds ZSC00002 alongside ZSC00001. A second PUT omits ZSC00002 entirely, triggering removal by omission. A third PUT reinstates ZSC00002. WAIT steps pause before each state-change so the DB can be inspected.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD Creates Short Course 1 (ZSC00001, completed)",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-course1.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Short Course 1",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-approve-course1.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD PUTs ZSC00001 (completed) + ZSC00002 (new) — Progression",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "04-put-both-courses.json",
      "extract": {}
    },
    {
      "name": "Verify 2 Learnings in Learning DB and 2 unapproved Earnings profiles, then press Enter to remove ZSC00002 by omission",
      "type": "Wait"
    },
    {
      "name": "SLD PUTs ZSC00001 only — ZSC00002 removed by omission",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "06-put-course1-only.json",
      "extract": {}
    },
    {
      "name": "Verify ZSC00002 episode IsRemoved=true and Earnings profile deleted, then press Enter to reinstate",
      "type": "Wait"
    },
    {
      "name": "SLD PUTs ZSC00001 + ZSC00002 — reinstate ZSC00002",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "08-put-both-courses.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "2 ShortCourseEpisode rows in Learning DB",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "assert-learning-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 non-removed ShortCourseEpisode rows in Earnings DB (ZSC00002 reinstated)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-earnings-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 ThirtyPercent instalments (reinstated ZSC00002 earnings profile recreated)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-thirty-percent-instalments.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 LearningComplete instalments",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-learning-complete-instalments.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "1 payable ThirtyPercent instalment (ZSC00001 only — ZSC00002 unapproved)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-payable-thirty-percent.sql",
      "expected": [
        { "field": "Count", "value": "1" }
      ]
    },
    {
      "name": "1 payable LearningComplete instalment (ZSC00001 only — ZSC00002 unapproved)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-payable-learning-complete.sql",
      "expected": [
        { "field": "Count", "value": "1" }
      ]
    }
  ]
}
