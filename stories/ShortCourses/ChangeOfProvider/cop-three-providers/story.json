{
  "name": "CoP - Three Providers",
  "group": "Short Course",
  "subGroup": "Change of Provider",
  "description": "Provider A creates a short course, gets approved, then withdraws (no milestones). Provider B then creates a new short course for the same learner, gets approved, then also withdraws (no milestones). Provider C creates a third short course, gets approved, and completes — claiming both the 30% milestone and completion in a single PUT.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD (Provider A) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-provider-a.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider A Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-approve-provider-a.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD (Provider A) Withdraws the Learner",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learnerKey}",
      "payloadFile": "04-put-withdrawal-provider-a.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider B) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005078/shortCourses",
      "payloadFile": "05-post-provider-b.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider B Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "06-approve-provider-b.json",
      "delayMs": 3000
    },
    {
      "name": "SLD (Provider B) Withdraws the Learner",
      "verb": "PUT",
      "route": "/providers/10005078/shortCourses/{learnerKey}",
      "payloadFile": "07-put-withdrawal-provider-b.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider C) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005079/shortCourses",
      "payloadFile": "08-post-provider-c.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider C Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "09-approve-provider-c.json",
      "delayMs": 3000
    },
    {
      "name": "SLD (Provider C) Claims 30% Milestone and Completion",
      "verb": "PUT",
      "route": "/providers/10005079/shortCourses/{learnerKey}",
      "payloadFile": "10-put-completion-provider-c.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "3 ShortCourseEpisode rows in Learning DB",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "assert-learning-episodes.sql",
      "expected": [
        { "field": "Count", "value": "3" }
      ]
    },
    {
      "name": "3 ShortCourseEpisode rows in Earnings DB",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-earnings-episodes.sql",
      "expected": [
        { "field": "Count", "value": "3" }
      ]
    }
  ]
}
