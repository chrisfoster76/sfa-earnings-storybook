{
  "name": "Short Course - Removal & Reinstatement",
  "group": "Short Course",
  "description": "Creates a short course, approves it, DELETEs it, then reinstates it by POSTing it again",
  "extraDescription":  "When reinstated, the 30% milestone is claimed at the same time, which it wasn't previously.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD Creates the Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-short-course.json"
    },
    {
      "name": "Employer Approves the Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Deletes the Short Course",
      "verb": "DELETE",
      "route": "/providers/10005077/shortCourses/{learnerKey}"
    },
    {
      "name": "SLD Reinstates the Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "04-post-reinstate.json"
    }
  ]
}
