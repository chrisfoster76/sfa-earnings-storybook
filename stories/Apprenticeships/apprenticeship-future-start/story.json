{
  "name": "Apprenticeship — Future Start (next month)",
  "description": "Creates and approves an apprenticeship starting next month (2026-05-01). FM36 should NOT return data for this learner in the current collection period — mirrors the Fm36.feature 'Do not retrieve Fm36 data for Inactive learners' nextMonthFirstDay scenario.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Submits Updated Learner Details",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "03-put-on-programme.json",
      "extract": {}
    }
  ]
}
