{
  "name": "Apprenticeship — Deletion, Reinstatement & Withdrawal",
  "description": "Creates an apprenticeship, removes it via DELETE, then reinstates it via POST with a withdrawal date",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Removes the Apprenticeship",
      "verb": "DELETE",
      "route": "/providers/10005077/learning/{learnerKey}?academicYear=2526",
      "extract": {}
    },
    {
      "name": "SLD Reinstates the Apprenticeship with Withdrawal",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "03-put-reinstate-withdrawn.json",
      "extract": {}
    }
  ]
}
