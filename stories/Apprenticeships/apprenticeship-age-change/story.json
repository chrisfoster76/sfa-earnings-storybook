{
  "name": "Apprenticeship — Age Change (18 → 50)",
  "group": "Apprenticeship",
  "description": "Creates an apprenticeship with a learner aged 18 at start date, then PUTs an update changing the DOB so the learner is 50 at start date",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Submits Updated Learner with New Age",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learningKey}",
      "payloadFile": "03-put-age-change.json",
      "extract": {}
    }
  ]
}
