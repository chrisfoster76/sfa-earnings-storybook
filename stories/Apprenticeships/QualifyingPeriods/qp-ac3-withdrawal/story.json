{
  "name": "3: 42-day QP reached; retain earnings",
  "subGroup": "Withdrawal",
  "description": "Creates a 2-year apprenticeship (730-day planned duration, qualifying period = 42 days), approves it, then records a withdrawal after 60 days in learning. Because 30 < 42, earnings for periods prior to the withdrawal date should be removed.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Records Withdrawal (2 months in learning — above 42-day qualifying period)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "03-put-withdrawal.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "Regular instalments retained",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "count-instalments.sql",
      "expected": "2"
    }
  ]
}
