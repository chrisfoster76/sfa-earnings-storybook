{
  "name": "App. BiL Completion after QP",
  "subGroup": "Return from a Break In Learning",
  "description": "Creates a 1-year apprenticeship (2024-10-01 to 2025-09-30), then PUTs an update with a break in learning (pause 2025-02-01, resume 2025-05-31). The post-break expected end date is 2026-01-27 (original end 2025-09-30 pushed back by the 119-day break). Learner completes 43 days after resuming (2025-07-13), which exceeds the 42-day qualifying period — earnings should be retained.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Submits Break In Learning and Completion",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "03-put-break-and-completion.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "Regular instalments pre-break",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "count-1k-instalments-pre-break.sql",
      "expected": [
        {
          "field": "Count",
          "value": "4"
        }
      ]
    },
    {
      "name": "Regular instalments post-break",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "count-1k-instalments-post-break.sql",
      "expected": [
        {
          "field": "Count",
          "value": "2"
        }
      ]
    },
    {
      "name": "Completion payment",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "completion-payment.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "3000"
        },
        {
          "field": "DeliveryPeriod",
          "value": "12"
        }
      ]
    },
    {
      "name": "Balancing payment",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "balancing-payment.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "6000"
        },
        {
          "field": "DeliveryPeriod",
          "value": "12"
        }
      ]
    }
  ]
}
