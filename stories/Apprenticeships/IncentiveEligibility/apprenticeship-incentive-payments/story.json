{
  "name": "Eligibile",
  "description": "SLD POSTs a draft 2-year apprenticeship for an 18-year-old learner (Riley Brooks, DOB 2012-01-01, start 2030-04-01), and the employer approves it. Both incentive milestones fall within the end date: the 90th day (2030-06-29, 2930 DP11) and the 365th day (2031-03-31, 3031 DP8). Provider and employer incentives (£500 each) should be generated at each milestone.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD Creates a Draft Apprenticeship",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "01-post-apprenticeship.json",
      "extract": {},
      "delayMs": 3000
    },
    {
      "name": "Employer Approves the Draft Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Submits Learner Details",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "04-put-on-programme.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "90-day provider incentive (2930 DP11)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "90d-provider-incentive.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "500"
        },
        {
          "field": "DeliveryPeriod",
          "value": "11"
        }
      ]
    },
    {
      "name": "90-day employer incentive (2930 DP11)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "90d-employer-incentive.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "500"
        },
        {
          "field": "DeliveryPeriod",
          "value": "11"
        }
      ]
    },
    {
      "name": "365-day provider incentive (3031 DP8)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "365d-provider-incentive.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "500"
        },
        {
          "field": "DeliveryPeriod",
          "value": "8"
        }
      ]
    },
    {
      "name": "365-day employer incentive (3031 DP8)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "365d-employer-incentive.sql",
      "expected": [
        {
          "field": "Amount",
          "value": "500"
        },
        {
          "field": "DeliveryPeriod",
          "value": "8"
        }
      ]
    }
  ]
}
