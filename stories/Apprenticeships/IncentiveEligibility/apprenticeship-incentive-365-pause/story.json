{
  "name": "365 day Pause eligibility",
  "description": "SLD POSTs a draft 2-year apprenticeship for Riley Brooks (DOB 2012-01-01, start 2030-04-01), and the employer approves it. PUTs a pause on the 365th day (2031-03-31) — the incentive milestone falls on that day, so both incentive payments should be generated. Then moves the pause back one day to the 364th (2031-03-30), which is before the milestone — both incentives should be removed.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD Creates a Draft Apprenticeship",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "01-post-apprenticeship.json",
      "extract": {},
      "delayMs": 3000
    },
    {
      "name": "Employer Approves the Draft Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Submits Pause on Day 365 (2031-03-31)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "04-put-pause-day365.json",
      "extract": {}
    },
    {
      "name": "365-day incentives generated (count = 2)",
      "type": "Assert",
      "connectionName": "Earnings",
      "queryFile": "count-incentives.sql",
      "expected": [
        {
          "field": "Count",
          "value": "2"
        }
      ]
    },
    {
      "name": "SLD Moves Pause Back to Day 364 (2031-03-30)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "05-put-pause-day364.json",
      "extract": {}
    },
    {
      "name": "365-day incentives removed (count = 0)",
      "type": "Assert",
      "connectionName": "Earnings",
      "queryFile": "count-incentives.sql",
      "expected": [
        {
          "field": "Count",
          "value": "0"
        }
      ]
    }
  ]
}
