{
  "name": "Apprenticeship — E&M + Learning Support, then Deletion",
  "group": "Apprenticeship",
  "subGroup": "English & Maths",
  "description": "Creates an apprenticeship, PUTs English & Maths and Learning Support, then removes it via DELETE",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Submits English & Maths and Learning Support",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learningKey}",
      "payloadFile": "03-put-enm-ls.json",
      "extract": {}
    },
    {
      "name": "Wait — inspect DB after E&M + Learning Support, then continue with deletion",
      "type": "Wait"
    },
    {
      "name": "SLD Removes the Apprenticeship",
      "verb": "DELETE",
      "route": "/providers/10005077/learning/{learningKey}",
      "extract": {}
    }
  ]
}
