{
  "name": "Start Date Change Auto Approved",
  "description": "SLD POSTs a draft apprenticeship with a single price, Commitments approves it via ApprenticeshipCreatedEvent, then SLD PUTs the same learner with a new StartDate (and the single price's fromDate moved to match) and nothing else changed. The new start date is on the 15th, so the local Approvals stub auto-approves it. The outer API clears Learning's flag and tells Earnings no further approval is needed (FLP-2089), so Earnings takes the new start date and its episode is not flagged Bus messages are asserted from EventHub's ReceivedEvents, so EventHub must be running locally (the storybook checks before running): the expected events are waited for, then the ones that must not appear are checked.",
  "wipeOnRun": true,
  "tags": [
    "Approvals Integration"
  ],
  "steps": [
    {
      "name": "SLD Creates a Draft Apprenticeship",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "01-post-apprenticeship.json",
      "extract": {},
      "delayMs": 3000
    },
    {
      "name": "Employer Approves the Draft Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learner-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Changes the Start Date (and the Price's From Date)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "04-put-start-date-change.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "Single price now starts on the new start date",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "05-episode-price-start-date.sql",
      "expected": [
        {
          "field": "StartDate",
          "value": "2025-09-15"
        },
        {
          "field": "PriceCount",
          "value": "1"
        }
      ]
    },
    {
      "name": "Learning episode does not need further approval",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "06-episode-further-approval-needed.sql",
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "False"
        }
      ]
    },
    {
      "name": "Earnings has the new start date",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "07-earnings-price-start-date.sql",
      "expected": [
        {
          "field": "StartDate",
          "value": "2025-09-15"
        }
      ]
    },
    {
      "name": "Earnings episode does not need further approval",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "08-earnings-further-approval-needed.sql",
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "False"
        }
      ]
    },
    {
      "name": "The start date change is echoed to Approvals and on-programme payments are released from the 15th",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "09-eventhub-events.sql",
      "waitMs": 15000,
      "expected": [
        {
          "field": "ApprovedStartDateTo15th",
          "value": "1"
        },
        {
          "field": "OnProgrammePaymentsFrom15th",
          "value": "1"
        }
      ]
    },
    {
      "name": "Payments are not withheld",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "09-eventhub-events.sql",
      "expected": [
        {
          "field": "Withholds",
          "value": "0"
        }
      ]
    }
  ]
}
