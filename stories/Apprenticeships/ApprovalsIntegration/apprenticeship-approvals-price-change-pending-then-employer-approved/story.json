{
  "name": "Price Change Pending Approval, Then Employer Approved",
  "description": "FLP-1369 / FLP-2082. SLD POSTs a draft apprenticeship (training 6400, EPA 1600), Commitments approves it, then SLD PUTs a changed price (training 7200, EPA 1800), which the local Approvals stub answers EmployerApprovalRequested (pending). Both Learning and Earnings flag the episode FurtherApprovalNeeded and Earnings withholds payments. The employer then approves: Approvals publishes LearningChangeApprovedEvent with no Changes and a top-level Prices list matching what Learning holds. Learning clears its flag, echoes the approved prices to Approvals (ApprovedLearningUpdatedEvent with Prices and no Changes) and publishes EpisodeApprovedEvent. Earnings clears its flag and releases on-programme payments at the new price (9000). Bus messages are asserted from EventHub's ReceivedEvents, so EventHub must be running locally (the storybook checks before running).",
  "wipeOnRun": true,
  "tags": [
    "Approvals Integration"
  ],
  "steps": [
    {
      "name": "SLD Creates a Draft Apprenticeship",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "01-post-apprenticeship.json",
      "extract": {},
      "delayMs": 3000
    },
    {
      "name": "Employer Approves the Draft Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner and Learning Keys",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-keys.sql",
      "extract": {
        "learnerKey": "LearnerKey",
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Changes the Price (the local Approvals stub answers a price-only change EmployerApprovalRequested)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "04-put-price-change.json",
      "extract": {}
    },
    {
      "name": "Capture the Earnings Flag While the Change Is Pending",
      "type": "Sql",
      "connectionName": "Earnings",
      "queryFile": "08-earnings-further-approval-needed.sql",
      "extract": {
        "earningsFurtherApprovalNeededWhilePending": "FurtherApprovalNeeded"
      }
    },
    {
      "name": "Employer Approves the Price Change",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.LearningChangeApprovedEvent",
      "payloadFile": "09-learning-change-approved-event.json"
    }
  ],
  "assertions": [
    {
      "name": "Earnings episode needed further approval while the change was pending",
      "type": "Context",
      "expected": [
        {
          "field": "earningsFurtherApprovalNeededWhilePending",
          "value": "True"
        }
      ]
    },
    {
      "name": "Learning episode no longer needs further approval",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "06-episode-further-approval-needed.sql",
      "waitMs": 15000,
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "False"
        }
      ]
    },
    {
      "name": "Earnings episode no longer needs further approval",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "08-earnings-further-approval-needed.sql",
      "waitMs": 15000,
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "False"
        }
      ]
    },
    {
      "name": "Learning still has the approved price",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "05-episode-prices.sql",
      "expected": [
        {
          "field": "PriceCount",
          "value": "1"
        },
        {
          "field": "LatestTrainingPrice",
          "value": "7200"
        },
        {
          "field": "LatestEndPointAssessmentPrice",
          "value": "1800"
        }
      ]
    },
    {
      "name": "Earnings still has the approved price",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "07-earnings-prices.sql",
      "expected": [
        {
          "field": "PriceCount",
          "value": "1"
        },
        {
          "field": "LatestAgreedPrice",
          "value": "9000"
        }
      ]
    },
    {
      "name": "Payments are withheld once, then the approved prices are echoed, the episode approved, and on-programme payments released at the new price",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "10-eventhub-events.sql",
      "waitMs": 15000,
      "expected": [
        {
          "field": "Withholds",
          "value": "1"
        },
        {
          "field": "ApprovedPricesEchoed",
          "value": "1"
        },
        {
          "field": "EpisodeApprovals",
          "value": "1"
        },
        {
          "field": "OnProgrammePaymentsAt9000",
          "value": "1"
        }
      ]
    },
    {
      "name": "Only the approved prices are echoed",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "10-eventhub-events.sql",
      "expected": [
        {
          "field": "ApprovedLearningUpdates",
          "value": "1"
        }
      ]
    }
  ]
}
