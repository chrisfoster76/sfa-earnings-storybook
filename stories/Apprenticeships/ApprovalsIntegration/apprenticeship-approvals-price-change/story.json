{
  "name": "Price Change Pending Approval",
  "description": "FLP-1369. SLD POSTs a draft apprenticeship with a single price (training 6400, EPA 1600), Commitments approves it, then SLD PUTs the same learner with a changed price (training 7200, EPA 1800) and nothing else changed. Learning marks Prices as needing approval and asks Approvals with NewPrices and no Changes; the local Approvals stub answers a price-only change EmployerApprovalRequested (pending). Earnings is still updated with the new price, both Learning and Earnings flag the episode FurtherApprovalNeeded, and Earnings withholds payments. Bus messages are asserted from EventHub's ReceivedEvents, so EventHub must be running locally (the storybook checks before running).",
  "wipeOnRun": true,
  "tags": [
    "Approvals Integration"
  ],
  "steps": [
    {
      "name": "SLD Creates a Draft Apprenticeship",
      "verb": "POST",
      "route": "/providers/10005077/learners",
      "payloadFile": "01-post-apprenticeship.json",
      "extract": {},
      "delayMs": 3000
    },
    {
      "name": "Employer Approves the Draft Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learner and Learning Keys",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-keys.sql",
      "extract": {
        "learnerKey": "LearnerKey",
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Changes the Price (the local Approvals stub answers a price-only change EmployerApprovalRequested)",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learnerKey}",
      "payloadFile": "04-put-price-change.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "Learning has the new price",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "05-episode-prices.sql",
      "expected": [
        {
          "field": "PriceCount",
          "value": "1"
        },
        {
          "field": "FirstPriceStartDate",
          "value": "2025-09-01"
        },
        {
          "field": "LatestTrainingPrice",
          "value": "7200"
        },
        {
          "field": "LatestEndPointAssessmentPrice",
          "value": "1800"
        }
      ]
    },
    {
      "name": "Learning episode needs further approval",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "06-episode-further-approval-needed.sql",
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "True"
        }
      ]
    },
    {
      "name": "Earnings has the new price",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "07-earnings-prices.sql",
      "expected": [
        {
          "field": "PriceCount",
          "value": "1"
        },
        {
          "field": "LatestAgreedPrice",
          "value": "9000"
        }
      ]
    },
    {
      "name": "Earnings episode needs further approval",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "08-earnings-further-approval-needed.sql",
      "expected": [
        {
          "field": "FurtherApprovalNeeded",
          "value": "True"
        }
      ]
    },
    {
      "name": "Earnings withholds payments for the learning",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "10-eventhub-events.sql",
      "waitMs": 15000,
      "expected": [
        {
          "field": "Withholds",
          "value": "1"
        }
      ]
    },
    {
      "name": "Nothing is echoed to Approvals and no on-programme payments are released at the new price",
      "type": "SQL",
      "connectionName": "EventHub",
      "queryFile": "10-eventhub-events.sql",
      "expected": [
        {
          "field": "ApprovedLearningUpdates",
          "value": "0"
        },
        {
          "field": "OnProgrammePaymentsAt9000",
          "value": "0"
        }
      ]
    }
  ]
}
