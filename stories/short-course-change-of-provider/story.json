{
  "name": "Short Course - Change of Provider",
  "group": "Short Course",
  "subGroup": "Change of Provider",
  "description": "Provider 1 creates a short course, approves it, then withdraws the learner and claims the 30% milestone in the same PUT. Provider 2 then creates a new short course for the same learner and course, starting after the withdrawal date, and claims both the 30% milestone and completion in a single PUT.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD (Provider 1) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-short-course-provider1.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider 1 Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-apprenticeship-created-event-provider1.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Withdraws the Learner and Claims 30% Milestone (Provider 1)",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learningKey}",
      "payloadFile": "04-put-withdrawal.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider 2) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005078/shortCourses",
      "payloadFile": "05-post-short-course-provider2.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider 2 Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "06-apprenticeship-created-event-provider2.json",
      "delayMs": 3000
    },
    {
      "name": "SLD (Provider 2) Claims 30% Milestone and Completion",
      "verb": "PUT",
      "route": "/providers/10005078/shortCourses/{learningKey}",
      "payloadFile": "08-put-completion-provider2.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "2 ShortCourseEpisode rows in Learning DB",
      "type": "SQL",
      "connectionName": "Learning",
      "queryFile": "assert-learning-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 ShortCourseEpisode rows in Earnings DB",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-earnings-episodes.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "2 ThirtyPercentLearningComplete instalments (one per provider - TEMPORARY)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-thirty-percent-instalments.sql",
      "expected": [
        { "field": "Count", "value": "2" }
      ]
    },
    {
      "name": "1 LearningComplete instalment",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "assert-learning-complete-instalments.sql",
      "expected": [
        { "field": "Count", "value": "1" }
      ]
    }
  ]
}
