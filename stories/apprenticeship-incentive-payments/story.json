{
  "name": "2 yr App, under 19 (eligible)",
  "group": "Apprenticeships Incentives",
  "description": "Creates and approves a 2-year apprenticeship for an 18-year-old learner (Riley Brooks, DOB 2008-01-01, start 2026-04-01). Both incentive milestones fall within the end date: the 90th day (2026-06-29, 2526 DP11) and the 365th day (2027-03-31, 2627 DP8). Provider and employer incentives (£500 each) should be generated at each milestone.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Submits Learner Details",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learningKey}",
      "payloadFile": "03-put-on-programme.json",
      "extract": {}
    }
  ],
  "assertions": [
    {
      "name": "90-day provider incentive (2526 DP11)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "90d-provider-incentive.sql",
      "expected": [
        { "field": "Amount", "value": "500" },
        { "field": "DeliveryPeriod", "value": "11" }
      ]
    },
    {
      "name": "90-day employer incentive (2526 DP11)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "90d-employer-incentive.sql",
      "expected": [
        { "field": "Amount", "value": "500" },
        { "field": "DeliveryPeriod", "value": "11" }
      ]
    },
    {
      "name": "365-day provider incentive (2627 DP8)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "365d-provider-incentive.sql",
      "expected": [
        { "field": "Amount", "value": "500" },
        { "field": "DeliveryPeriod", "value": "8" }
      ]
    },
    {
      "name": "365-day employer incentive (2627 DP8)",
      "type": "SQL",
      "connectionName": "Earnings",
      "queryFile": "365d-employer-incentive.sql",
      "expected": [
        { "field": "Amount", "value": "500" },
        { "field": "DeliveryPeriod", "value": "8" }
      ]
    }
  ]
}
