{
  "name": "English & Maths — Pause",
  "group": "Apprenticeship",
  "subGroup": "English & Maths",
  "description": "Creates a 2-year apprenticeship (2026-04-01 to 2028-03-31), then PUTs a Maths aim with a pause date of 2026-10-01.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "Commitments Approves an Apprenticeship",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "01-apprenticeship-created-event.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD Submits English & Maths with Pause",
      "verb": "PUT",
      "route": "/providers/10005077/learning/{learningKey}",
      "payloadFile": "03-put-enm-pause.json",
      "extract": {}
    }
  ]
}
