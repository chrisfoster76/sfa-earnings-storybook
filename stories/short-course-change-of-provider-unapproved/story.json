{
  "name": "Short Course - Change of Provider (Provider 1 Unapproved)",
  "group": "Short Course",
  "subGroup": "Change of Provider",
  "description": "Provider 1 creates a short course but never gets employer approval. Provider 2 then creates a new short course for the same learner and course, gets approved, claims milestones, completes, then is deleted.",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD (Provider 1) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-short-course-provider1.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider 2) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005078/shortCourses",
      "payloadFile": "02-post-short-course-provider2.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider 2 Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "03-apprenticeship-created-event-provider2.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "04-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD (Provider 2) Claims 30% Milestone",
      "verb": "PUT",
      "route": "/providers/10005078/shortCourses/{learningKey}",
      "payloadFile": "05-put-thirty-percent-provider2.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider 2) Claims Completion",
      "verb": "PUT",
      "route": "/providers/10005078/shortCourses/{learningKey}",
      "payloadFile": "06-put-completion-provider2.json",
      "extract": {}
    },
    {
      "name": "SLD Deletes Provider 2 Short Course",
      "verb": "DELETE",
      "route": "/providers/10005078/shortCourses/{learningKey}",
      "extract": {}
    }
  ]
}
