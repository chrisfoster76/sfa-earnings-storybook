{
  "name": "CoP - Provider B Deletion",
  "group": "Short Course",
  "subGroup": "Change of Provider",
  "description": "Full CoP setup: Provider A withdraws, Provider B is approved. Provider B's short course is then removed via DELETE (ILR removal).",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD (Provider A) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-provider-a.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider A Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "02-approve-provider-a.json",
      "delayMs": 3000
    },
    {
      "name": "Get Learning Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "03-get-learning-key.sql",
      "extract": {
        "learningKey": "LearningKey"
      }
    },
    {
      "name": "SLD (Provider A) Withdraws the Learner",
      "verb": "PUT",
      "route": "/providers/10005077/shortCourses/{learningKey}",
      "payloadFile": "04-put-provider-a-withdrawal.json",
      "extract": {}
    },
    {
      "name": "SLD (Provider B) Creates a Short Course",
      "verb": "POST",
      "route": "/providers/10005078/shortCourses",
      "payloadFile": "05-post-provider-b.json",
      "extract": {}
    },
    {
      "name": "Employer Approves Provider B Short Course",
      "type": "Event",
      "eventType": "SFA.DAS.CommitmentsV2.Messages.Events.ApprenticeshipCreatedEvent",
      "payloadFile": "06-approve-provider-b.json",
      "delayMs": 3000
    },
    {
      "name": "SLD Removes Provider B Short Course",
      "verb": "DELETE",
      "route": "/providers/10005078/shortCourses/{learningKey}",
      "extract": {}
    }
  ]
}
