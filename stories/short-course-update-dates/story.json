{
  "name": "Short Course - Update Dates",
  "group": "Short Course",
  "description": "Creates a short course (1 Aug 2025 - 1 Nov 2025), then updates the dates via PUT without approval (1 Oct 2025 - 1 Feb 2026)",
  "wipeOnRun": true,
  "steps": [
    {
      "name": "SLD Create a Short Course",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "01-post-short-course.json",
      "extract": {}
    },
    {
      "name": "Get Learner Key",
      "type": "Sql",
      "connectionName": "Learning",
      "queryFile": "02-get-learning-key.sql",
      "extract": {
        "learnerKey": "LearnerKey"
      }
    },
    {
      "name": "SLD Updates Course Dates",
      "verb": "POST",
      "route": "/providers/10005077/shortCourses",
      "payloadFile": "03-post-update-dates.json",
      "extract": {}
    }
  ]
}
